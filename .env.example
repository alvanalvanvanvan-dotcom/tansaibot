# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-token-here

# Tans AI API Gateway
TANS_AI_BASE_URL=http://localhost:20130/api/v1
# Format key terbaru: tans_ + 25 karakter alphanumeric (huruf besar/kecil + angka, tanpa simbol)
# Kalau key kamu masih versi lama dengan simbol (#, &, @), bungkus dengan kutip ganda: "tans_xxx#xxx"
TANS_AI_API_KEY=tans_yourAlphanumericKey25Chars

# Default model (bisa dilihat lewat /models di Telegram)
TANS_AI_DEFAULT_MODEL=gpt-4o

# Jumlah maksimum pesan riwayat per sesi yang dikirim ke AI sebagai konteks
HISTORY_MAX_MESSAGES=20

# Timeout request ke Tans AI (detik)
TANS_AI_TIMEOUT=60

# Lokasi file SQLite untuk riwayat percakapan
# (opsional - default ke chat_history.db di folder bot)
# CHAT_DB_PATH=/path/ke/chat_history.db

# Auto-generate judul sesi via AI setelah pertukaran pertama (1=aktif, 0=nonaktif).
AUTO_TITLE=1

# Daftar Telegram user ID yang punya akses /admin & /broadcast (pisahkan koma).
# Cari user ID kamu lewat bot @userinfobot.
# ADMIN_TELEGRAM_IDS=123456789,987654321

# Rate limit per user. 0 = nonaktif. Admin selalu lolos rate limit.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=500

# Waitlist mode: kalau 1, user baru masuk status "waitlist" dan harus
# di-/approve admin dulu sebelum bisa chat dengan bot.
WAITLIST_MODE=0

# --- Futuristic Features (PR 3) ---------------------------------------------

# Smart follow-up suggestions: setelah setiap jawaban AI, bot generate 3
# pertanyaan lanjutan singkat sebagai tombol inline. 1=aktif, 0=nonaktif.
FOLLOW_UPS_ENABLED=1

# Smart context summarization. Saat jumlah pesan di satu sesi melewati
# SUMMARIZATION_THRESHOLD, bot otomatis meringkas pesan lama jadi satu
# paragraf sehingga konteks AI tidak terpotong. Set THRESHOLD=0 untuk
# matikan fitur ini.
#   THRESHOLD    : minimum total pesan sebelum bot mulai meringkas
#   KEEP_LAST    : jumlah pesan terakhir yang selalu dikirim verbatim
#   DELTA        : berapa pesan baru menumpuk sebelum bot re-summarize
SUMMARIZATION_THRESHOLD=24
SUMMARIZATION_KEEP_LAST=10
SUMMARIZATION_DELTA=12

# Voice input/output (opsional). Bot pakai endpoint OpenAI-compatible:
#   POST {VOICE_API_BASE}/audio/transcriptions  (Whisper)
#   POST {VOICE_API_BASE}/audio/speech          (TTS)
# Biarkan VOICE_API_KEY kosong untuk mematikan voice sama sekali.
VOICE_API_BASE=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_TIMEOUT=60

# Username bot (tanpa @). Hanya cosmetic untuk help text inline mode.
# BOT_USERNAME=tansaibot

# ============================================================
# v2 Tier-S additions
# ============================================================

# Structured logging level (#13). Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Sentry DSN for error tracking (#14). Leave empty to disable.
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# Health server port (#15). Exposes /healthz and /metricsz
HEALTH_PORT=8081
