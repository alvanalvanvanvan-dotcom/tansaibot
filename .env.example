# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-token-here

# Tans AI API Gateway
TANS_AI_BASE_URL=http://localhost:20130/api/v1
# Format key terbaru: tans_ + 25 karakter alphanumeric (huruf besar/kecil + angka, tanpa simbol)
# Kalau key kamu masih versi lama dengan simbol (#, &, @), bungkus dengan kutip ganda: "tans_xxx#xxx"
TANS_AI_API_KEY=tans_yourAlphanumericKey25Chars

# Default model (bisa dilihat lewat /models di Telegram)
TANS_AI_DEFAULT_MODEL=gpt-4o

# Jumlah maksimum pesan riwayat per sesi yang dikirim ke AI sebagai konteks
HISTORY_MAX_MESSAGES=20

# Timeout request ke Tans AI (detik)
TANS_AI_TIMEOUT=60

# Lokasi file SQLite untuk riwayat percakapan
# (opsional - default ke chat_history.db di folder bot)
# CHAT_DB_PATH=/path/ke/chat_history.db
